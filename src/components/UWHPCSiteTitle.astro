---
import logo from '../assets/uwhpc-logo-mark.svg';

const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a class="uwhpc-site-title" href={siteTitleHref} aria-label="UWHPC Documentation home">
  <img src={logo.src} alt="" width="387" height="234" />
  <span class="uwhpc-wordmark" aria-hidden="true">UW<span>HPC</span></span>
  <span class="uwhpc-divider" aria-hidden="true"></span>
  <span class="uwhpc-docs" aria-hidden="true">Docs</span>
</a>

<style>
  .uwhpc-site-title {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: 0.65rem;
    color: #ededed;
    text-decoration: none;
    white-space: nowrap;
  }

  .uwhpc-site-title:focus-visible {
    outline: 2px solid #cd393c;
    outline-offset: 4px;
  }

  img {
    width: auto;
    height: 1.65rem;
  }

  .uwhpc-wordmark {
    font-family: 'IBM Plex Sans Variable', sans-serif;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .uwhpc-wordmark span {
    color: #cd393c;
  }

  .uwhpc-divider {
    width: 1px;
    height: 1.25rem;
    background: #2e2e2e;
  }

  .uwhpc-docs {
    overflow: hidden;
    color: #6e6e6e;
    font-family: 'IBM Plex Sans Variable', sans-serif;
    font-size: 0.875rem;
    font-weight: 400;
  }

  @media (max-width: 24rem) {
    .uwhpc-divider,
    .uwhpc-docs {
      display: none;
    }
  }
</style>
